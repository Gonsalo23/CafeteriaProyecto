-- ---------------------------------------------------------
-- BORRAR TABLAS SI YA EXISTEN
-- ---------------------------------------------------------

drop table if exists detalle_pedido cascade;
drop table if exists producto_alergeno cascade;
drop table if exists pedido cascade;
drop table if exists cliente cascade;
drop table if exists usuario cascade;
drop table if exists cupon cascade;
drop table if exists descuento cascade;
drop table if exists producto cascade;
drop table if exists categoria cascade;
drop table if exists alergeno cascade;


-- ---------------------------------------------------------
-- TABLA USUARIO
-- ---------------------------------------------------------

create table usuario (
    id integer primary key,
    nombre varchar(100) not null,
    "contraseña" varchar(255) not null,
    rol varchar(30) not null
);


-- ---------------------------------------------------------
-- TABLA CATEGORIA
-- ---------------------------------------------------------

create table categoria (
    id integer primary key,
    nombre varchar(100) not null,
    disponibilidad boolean not null
);


-- ---------------------------------------------------------
-- TABLA ALERGENO
-- ---------------------------------------------------------

create table alergeno (
    id integer primary key,
    nombre varchar(100) not null
);


-- ---------------------------------------------------------
-- TABLA CUPON
-- ---------------------------------------------------------

create table cupon (
    id integer primary key,
    codigo varchar(50) not null,
    tipo varchar(20) not null,
    valor numeric(8,2) not null,
    fecha_inicio timestamp not null,
    fecha_fin timestamp not null,
    max_usos integer not null,
    importe_minimo numeric(8,2) not null,
    email_cliente varchar(150)
);


-- ---------------------------------------------------------
-- TABLA DESCUENTO
-- ---------------------------------------------------------

create table descuento (
    id integer primary key,
    importe numeric(10,2) not null,
    origen varchar(100) not null
);


-- ---------------------------------------------------------
-- TABLA CLIENTE
-- ---------------------------------------------------------

create table cliente (
    id integer primary key,
    nombre varchar(100) not null,
    email varchar(150) not null,
    dni varchar(20),
    id_usuario integer,

    constraint fk_cliente_usuario
        foreign key (id_usuario)
        references usuario(id)
);


-- ---------------------------------------------------------
-- TABLA PRODUCTO
-- ---------------------------------------------------------

create table producto (
    id integer primary key,
    nombre varchar(255) not null,
    descripcion varchar(500),
    precio numeric(10,2) not null,
    disponible boolean not null,
    activo boolean not null,
    id_categoria integer not null,
    iva numeric(5,2),
    precio_iva numeric(10,2),

    constraint fk_producto_categoria
        foreign key (id_categoria)
        references categoria(id)
);


-- ---------------------------------------------------------
-- TABLA PEDIDO
-- ---------------------------------------------------------

create table pedido (
    id integer primary key,
    numero_turno integer not null,
    fecha timestamp not null,
    estado varchar(30) not null,
    id_cliente integer,
    id_cupon integer,
    id_descuento integer,

    constraint fk_pedido_cliente
        foreign key (id_cliente)
        references cliente(id),

    constraint fk_pedido_cupon
        foreign key (id_cupon)
        references cupon(id),

    constraint fk_pedido_descuento
        foreign key (id_descuento)
        references descuento(id)
);


-- ---------------------------------------------------------
-- TABLA DETALLE_PEDIDO
-- ---------------------------------------------------------

create table detalle_pedido (
    id integer primary key,
    id_pedido integer not null,
    id_producto integer not null,
    cantidad integer not null,
    precio numeric(10,2) not null,

    constraint fk_detalle_pedido
        foreign key (id_pedido)
        references pedido(id),

    constraint fk_detalle_producto
        foreign key (id_producto)
        references producto(id)
);


-- ---------------------------------------------------------
-- TABLA PRODUCTO_ALERGENO
-- ---------------------------------------------------------

create table producto_alergeno (
    id_producto integer not null,
    id_alergeno integer not null,

    primary key (id_producto, id_alergeno),

    constraint fk_pa_producto
        foreign key (id_producto)
        references producto(id),

    constraint fk_pa_alergeno
        foreign key (id_alergeno)
        references alergeno(id)
);


