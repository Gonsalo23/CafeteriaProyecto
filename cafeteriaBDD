CREATE SCHEMA IF NOT EXISTS cafeteria;

-- =========================================================
-- COFFEESTATION - DATOS COMPLETOS
-- BASE DE DATOS: cafeteria
-- ESQUEMA: cafeteria
-- =========================================================

-- ---------------------------------------------------------
-- BORRAR TABLAS SI YA EXISTEN
-- ---------------------------------------------------------

DROP TABLE IF EXISTS cafeteria.detalle_pedido CASCADE;
DROP TABLE IF EXISTS cafeteria.producto_alergeno CASCADE;
DROP TABLE IF EXISTS cafeteria.pedido CASCADE;
DROP TABLE IF EXISTS cafeteria.cliente CASCADE;
DROP TABLE IF EXISTS cafeteria.usuario CASCADE;
DROP TABLE IF EXISTS cafeteria.cupon CASCADE;
DROP TABLE IF EXISTS cafeteria.descuento CASCADE;
DROP TABLE IF EXISTS cafeteria.producto CASCADE;
DROP TABLE IF EXISTS cafeteria.categoria CASCADE;
DROP TABLE IF EXISTS cafeteria.alergeno CASCADE;


-- ---------------------------------------------------------
-- TABLA USUARIO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.usuario (
    id integer PRIMARY KEY,
    nombre varchar(100) NOT NULL,
    "contraseña" varchar(255) NOT NULL,
    rol varchar(30) NOT NULL
);


-- ---------------------------------------------------------
-- TABLA CATEGORIA
-- ---------------------------------------------------------

CREATE TABLE cafeteria.categoria (
    id integer PRIMARY KEY,
    nombre varchar(100) NOT NULL,
    disponibilidad boolean NOT NULL
);


-- ---------------------------------------------------------
-- TABLA ALERGENO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.alergeno (
    id integer PRIMARY KEY,
    nombre varchar(100) NOT NULL
);


-- ---------------------------------------------------------
-- TABLA CUPON
-- ---------------------------------------------------------

CREATE TABLE cafeteria.cupon (
    id integer PRIMARY KEY,
    codigo varchar(50) NOT NULL,
    tipo varchar(20) NOT NULL,
    valor numeric(8,2) NOT NULL,
    fecha_inicio timestamp NOT NULL,
    fecha_fin timestamp NOT NULL,
    max_usos integer NOT NULL,
    importe_minimo numeric(8,2) NOT NULL,
    email_cliente varchar(150)
);


-- ---------------------------------------------------------
-- TABLA DESCUENTO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.descuento (
    id integer PRIMARY KEY,
    importe numeric(10,2) NOT NULL,
    origen varchar(100) NOT NULL
);


-- ---------------------------------------------------------
-- TABLA CLIENTE
-- ---------------------------------------------------------

CREATE TABLE cafeteria.cliente (
    id integer PRIMARY KEY,
    nombre varchar(100) NOT NULL,
    email varchar(150) NOT NULL,
    dni varchar(20),
    id_usuario integer,

    CONSTRAINT fk_cliente_usuario
        FOREIGN KEY (id_usuario)
        REFERENCES cafeteria.usuario(id)
);


-- ---------------------------------------------------------
-- TABLA PRODUCTO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.producto (
    id integer PRIMARY KEY GENERATED BY DEFAULT AS IDENTITY,
    nombre varchar(255) NOT NULL,
    descripcion varchar(500),
    precio numeric(10,2) NOT NULL,
    disponible boolean NOT NULL,
    activo boolean NOT NULL,
    id_categoria integer NOT NULL,
    iva numeric(5,2),
    precio_iva numeric(10,2),

    CONSTRAINT fk_producto_categoria
        FOREIGN KEY (id_categoria)
        REFERENCES cafeteria.categoria(id)
);


-- ---------------------------------------------------------
-- TABLA PEDIDO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.pedido (
    id integer PRIMARY KEY,
    numero_turno integer NOT NULL,
    fecha timestamp NOT NULL,
    estado varchar(30) NOT NULL,
    id_cliente integer,
    id_cupon integer,
    id_descuento integer,

    CONSTRAINT fk_pedido_cliente
        FOREIGN KEY (id_cliente)
        REFERENCES cafeteria.cliente(id),

    CONSTRAINT fk_pedido_cupon
        FOREIGN KEY (id_cupon)
        REFERENCES cafeteria.cupon(id),

    CONSTRAINT fk_pedido_descuento
        FOREIGN KEY (id_descuento)
        REFERENCES cafeteria.descuento(id)
);

-- Los campos de cliente, cupón y descuento son opcionales.
ALTER TABLE cafeteria.pedido
    ALTER COLUMN id_cliente DROP NOT NULL,
    ALTER COLUMN id_cupon DROP NOT NULL,
    ALTER COLUMN id_descuento DROP NOT NULL;

-- Generar automáticamente el ID de los nuevos pedidos.
CREATE SEQUENCE IF NOT EXISTS cafeteria.pedido_id_seq;
ALTER TABLE cafeteria.pedido
    ALTER COLUMN id SET DEFAULT nextval('cafeteria.pedido_id_seq');
ALTER SEQUENCE cafeteria.pedido_id_seq
    OWNED BY cafeteria.pedido.id;


-- ---------------------------------------------------------
-- TABLA DETALLE_PEDIDO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.detalle_pedido (
    id integer PRIMARY KEY,
    id_pedido integer NOT NULL,
    id_producto integer NOT NULL,
    cantidad integer NOT NULL,
    precio numeric(10,2) NOT NULL,

    CONSTRAINT fk_detalle_pedido
        FOREIGN KEY (id_pedido)
        REFERENCES cafeteria.pedido(id),

    CONSTRAINT fk_detalle_producto
        FOREIGN KEY (id_producto)
        REFERENCES cafeteria.producto(id)
);

-- Generar automáticamente el ID de los nuevos detalles de pedido.
CREATE SEQUENCE IF NOT EXISTS cafeteria.detalle_pedido_id_seq;
ALTER TABLE cafeteria.detalle_pedido
    ALTER COLUMN id SET DEFAULT nextval('cafeteria.detalle_pedido_id_seq');
ALTER SEQUENCE cafeteria.detalle_pedido_id_seq
    OWNED BY cafeteria.detalle_pedido.id;


-- ---------------------------------------------------------
-- TABLA PRODUCTO_ALERGENO
-- ---------------------------------------------------------

CREATE TABLE cafeteria.producto_alergeno (
    id_producto integer NOT NULL,
    id_alergeno integer NOT NULL,

    PRIMARY KEY (id_producto, id_alergeno),

    CONSTRAINT fk_pa_producto
        FOREIGN KEY (id_producto)
        REFERENCES cafeteria.producto(id),

    CONSTRAINT fk_pa_alergeno
        FOREIGN KEY (id_alergeno)
        REFERENCES cafeteria.alergeno(id)
);


